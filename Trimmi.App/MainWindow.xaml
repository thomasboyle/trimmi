<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Trimmi_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trimmi_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Trimmi_App.Views"
    Title="Trimmi"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="2"
            CacheMode="BitmapCache"
            IsHitTestVisible="False"
            Opacity="0.32">
            <Border.Background>
                <ImageBrush ImageSource="{StaticResource GrainBitmap}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <TitleBar
            x:Name="AppTitleBar"
            Height="40"
            Title="Trimmi"
            Foreground="{ThemeResource AppInkBrush}" />

        <Grid
            Grid.Row="1"
            Padding="10"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <controls:GlassPanel Grid.Column="0">
                <controls:GlassPanel.PanelContent>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="1. Select Video" />

                            <Grid x:Name="DropZone" MinHeight="200" Padding="12,16">
                                <Rectangle
                                    x:Name="DropZoneOutline"
                                    RadiusX="10"
                                    RadiusY="10"
                                    Fill="{StaticResource FeatureGreenBackgroundBrush}"
                                    IsHitTestVisible="False"
                                    Stroke="{StaticResource DropZoneStrokeBrush}"
                                    StrokeDashArray="4,3"
                                    StrokeThickness="2.5" />
                                <Border
                                    x:Name="DropZoneHitTarget"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    DragOver="DropZone_DragOver"
                                    Drop="DropZone_Drop"
                                    PointerEntered="DropZone_PointerEntered"
                                    PointerExited="DropZone_PointerExited"
                                    Tapped="DropZone_Tapped"
                                    ToolTipService.ToolTip="Click to select a video file" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Image
                                        Width="48"
                                        Height="48"
                                        IsHitTestVisible="False"
                                        Source="{StaticResource IconCameraAddBitmap}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Foreground="{StaticResource ResultLabelBrush}"
                                        Style="{StaticResource BodyTextStyle}"
                                        Text="Drop a video file here" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Foreground="{StaticResource ResultLabelBrush}"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="or" />
                                    <Button
                                        x:Name="SelectFileButton"
                                        HorizontalAlignment="Center"
                                        Click="SelectFileButton_Click"
                                        Style="{StaticResource GlassSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="{StaticResource IconFolderBitmap}"
                                                Stretch="Uniform" />
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Select File" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Image
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,14,14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False"
                                    Opacity="0.9"
                                    Source="{StaticResource IconLeafBitmap}"
                                    Stretch="Uniform" />
                            </Grid>

                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Supports: MP4, MOV, MKV, WebM, AVI, etc."
                                TextWrapping="WrapWholeWords" />

                            <Border Height="8" />

                            <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="2. Output Settings" />

                            <TextBlock Style="{StaticResource GlassFieldLabelStyle}" Text="Encoder" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="EncoderCombo"
                                    Grid.Column="0"
                                    SelectionChanged="EncoderCombo_SelectionChanged"
                                    Style="{StaticResource GlassInputComboBoxStyle}" />
                                <Border
                                    x:Name="GpuBadge"
                                    Grid.Column="1"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SecurityBannerFillBrush}"
                                    BorderBrush="{StaticResource ResultCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontFamily="{StaticResource AppPixelFontBoldFamily}"
                                        FontSize="11"
                                        Foreground="{StaticResource SuccessGreenBrush}"
                                        Text="GPU" />
                                </Border>
                            </Grid>
                            <TextBlock
                                x:Name="EncoderHelperText"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="GPU selection uses the best encoder for your hardware. Falls back to CPU if GPU encode fails."
                                TextWrapping="WrapWholeWords" />

                            <TextBlock Style="{StaticResource GlassFieldLabelStyle}" Text="Format" />
                            <ComboBox
                                x:Name="FormatCombo"
                                SelectionChanged="FormatCombo_SelectionChanged"
                                Style="{StaticResource GlassInputComboBoxStyle}" />
                            <TextBlock
                                x:Name="FormatHelperText"
                                Style="{StaticResource CaptionTextStyle}"
                                TextWrapping="WrapWholeWords" />

                            <Border Height="8" />

                            <Border
                                x:Name="GpuStatusCard"
                                Padding="12"
                                Background="{StaticResource InputSurfaceBrush}"
                                BorderBrush="{StaticResource ResultCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        x:Name="GpuStatusIcon"
                                        FontSize="18"
                                        Foreground="{StaticResource SuccessGreenBrush}"
                                        Glyph="&#xE73E;" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            x:Name="GpuStatusTitle"
                                            FontFamily="{StaticResource AppPixelFontBoldFamily}"
                                            FontSize="12"
                                            Foreground="{StaticResource SuccessGreenBrush}"
                                            Text="GPU Acceleration: Available" />
                                        <TextBlock
                                            x:Name="GpuStatusName"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="Detecting..."
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </controls:GlassPanel.PanelContent>
            </controls:GlassPanel>

            <!-- Right main panel -->
            <controls:GlassPanel Grid.Column="1">
                <controls:GlassPanel.PanelContent>
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="240" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="FileNameLabel"
                                Style="{StaticResource BodyTextStyle}"
                                FontFamily="{StaticResource AppPixelFontBoldFamily}"
                                Text="No video loaded" />
                            <TextBlock
                                x:Name="TotalDurationLabel"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="00:00:00.000" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="#2A2924"
                            BorderBrush="#FF6B744F"
                            BorderThickness="1"
                            CornerRadius="12">
                            <MediaPlayerElement
                                x:Name="PreviewPlayer"
                                AreTransportControlsEnabled="False"
                                AutoPlay="False"
                                Stretch="Uniform" />
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="PlayPauseButton"
                                Click="PlayPauseButton_Click"
                                Style="{StaticResource GlassIconButtonStyle}"
                                ToolTipService.ToolTip="Play / Pause">
                                <FontIcon
                                    x:Name="PlayPauseIcon"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Grid.Column="1"
                                Click="PrevFrameButton_Click"
                                Style="{StaticResource GlassIconButtonStyle}"
                                ToolTipService.ToolTip="Previous frame">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE76B;" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                Click="NextFrameButton_Click"
                                Style="{StaticResource GlassIconButtonStyle}"
                                ToolTipService.ToolTip="Next frame">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE76C;" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Click="JumpEndButton_Click"
                                Style="{StaticResource GlassIconButtonStyle}"
                                ToolTipService.ToolTip="Jump to end">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE893;" />
                            </Button>
                            <FontIcon
                                Grid.Column="4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Foreground="{ThemeResource AppInkBrush}"
                                Glyph="&#xE767;" />
                            <Slider
                                x:Name="VolumeSlider"
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                Style="{StaticResource GlassSliderStyle}"
                                Value="80"
                                ValueChanged="VolumeSlider_ValueChanged" />
                            <TextBlock
                                x:Name="TimeReadout"
                                Grid.Column="7"
                                VerticalAlignment="Center"
                                MinWidth="210"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="00:00:00.000 / 00:00:00.000" />
                            <Button
                                Grid.Column="9"
                                Click="FullscreenButton_Click"
                                Style="{StaticResource GlassIconButtonStyle}"
                                ToolTipService.ToolTip="Fullscreen">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE740;" />
                            </Button>
                        </Grid>

                        <views:TimelineControl
                            x:Name="Timeline"
                            Grid.Row="3"
                            TrimChanged="Timeline_TrimChanged"
                            SeekRequested="Timeline_SeekRequested"
                            StartMarkerReleased="Timeline_StartMarkerReleased" />

                        <Grid Grid.Row="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource GlassFieldLabelStyle}"
                                Text="Start" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBox
                                    x:Name="StartEdit"
                                    Width="118"
                                    LostFocus="StartEdit_LostFocus"
                                    Style="{StaticResource GlassTimeEditStyle}"
                                    Text="00:00:00.000"
                                    KeyDown="TrimEdit_KeyDown" />
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                    <Button
                                        Width="20"
                                        Height="16"
                                        Padding="0"
                                        MinWidth="20"
                                        MinHeight="16"
                                        Click="StartUp_Click"
                                        Style="{StaticResource GlassIconButtonStyle}">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="9"
                                            Glyph="&#xE70E;" />
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="16"
                                        Padding="0"
                                        MinWidth="20"
                                        MinHeight="16"
                                        Click="StartDown_Click"
                                        Style="{StaticResource GlassIconButtonStyle}">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="9"
                                            Glyph="&#xE70D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                x:Name="TrimDurationLabel"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Duration  00:00:00.000" />

                            <TextBlock
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Style="{StaticResource GlassFieldLabelStyle}"
                                Text="End" />
                            <StackPanel
                                Grid.Column="6"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBox
                                    x:Name="EndEdit"
                                    Width="118"
                                    LostFocus="EndEdit_LostFocus"
                                    Style="{StaticResource GlassTimeEditStyle}"
                                    Text="00:00:00.000"
                                    KeyDown="TrimEdit_KeyDown" />
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                    <Button
                                        Width="20"
                                        Height="16"
                                        Padding="0"
                                        MinWidth="20"
                                        MinHeight="16"
                                        Click="EndUp_Click"
                                        Style="{StaticResource GlassIconButtonStyle}">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="9"
                                            Glyph="&#xE70E;" />
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="16"
                                        Padding="0"
                                        MinWidth="20"
                                        MinHeight="16"
                                        Click="EndDown_Click"
                                        Style="{StaticResource GlassIconButtonStyle}">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="9"
                                            Glyph="&#xE70D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Button
                            x:Name="ExportButton"
                            Grid.Row="5"
                            MinWidth="180"
                            HorizontalAlignment="Right"
                            Click="ExportButton_Click"
                            Content="Trim &amp; Export"
                            Style="{StaticResource GlassPrimaryButtonStyle}" />
                    </Grid>
                </controls:GlassPanel.PanelContent>
            </controls:GlassPanel>
        </Grid>

        <Border
            x:Name="UpdateBanner"
            Grid.RowSpan="2"
            Width="300"
            Margin="16,0,0,16"
            Padding="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{StaticResource ResultSurfaceBrush}"
            BorderBrush="{StaticResource ResultCardBorderBrush}"
            BorderThickness="1,1,1,2"
            CornerRadius="10"
            Visibility="Collapsed">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        Style="{StaticResource SubtitleTextStyle}"
                        Text="Update available" />
                    <Button
                        x:Name="UpdateDismissButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="UpdateDismissButton_Click"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Later">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="UpdateMessageText"
                    Grid.Row="1"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="WrapWholeWords"
                    Text="A newer version of Trimmi is ready to install." />

                <ProgressBar
                    x:Name="UpdateProgressBar"
                    Grid.Row="2"
                    Height="6"
                    Maximum="100"
                    Visibility="Collapsed" />

                <StackPanel
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="UpdateNowButton"
                        MinWidth="100"
                        Click="UpdateNowButton_Click"
                        Content="Update"
                        Style="{StaticResource GlassPrimaryButtonStyle}" />
                    <Button
                        x:Name="UpdateLaterButton"
                        MinWidth="80"
                        Click="UpdateDismissButton_Click"
                        Content="Later"
                        Style="{StaticResource GlassSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
